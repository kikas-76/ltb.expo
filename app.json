{
  "expo": {
    "name": "LoueTonBien",
    "slug": "louetonbien",
    "owner": "louetonbien",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "louetonbien",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.louetonbien.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "fr",
        "CFBundleLocalizations": [
          "fr"
        ]
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/LTB_favicon.png",
      "lang": "fr",
      "meta": {
        "viewport": "width=device-width, initial-scale=1"
      }
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://app.louetonbien.fr"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.louetonbien",
          "enableGooglePay": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "L'app a besoin d'accéder à la caméra pour scanner les QR codes de remise et photographier vos objets."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "L'app a besoin d'accéder à votre galerie pour ajouter des photos à vos annonces et à votre profil.",
          "cameraPermission": "L'app a besoin d'accéder à la caméra pour prendre des photos pour vos annonces et conversations."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "L'app utilise votre position pour définir votre adresse et afficher les annonces autour de vous."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F2E3",
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": "https://app.louetonbien.fr"
      },
      "eas": {
        "projectId": "c05f5d6a-d3a3-468d-a59d-abfdc209dcad"
      }
    },
    "locales": {
      "fr": "./locales/fr.json"
    }
  }
}
